# Entorno virtual (se regenera con INSTALAR.bat)
venv/

# Python compilado
__pycache__/
*.py[cod]
*.so

# Archivos temporales de Office (bloqueos)
~$*.xlsx
~$*.xls

# Archivos temporales de SQLite WAL mode (nunca deben ir al repo)
*.db-shm
*.db-wal

# Logs locales (servidor de desarrollo, etc.)
logs/

# Datos de runtime generados por la app (prevalece la versión del servidor)
data/progreso_bono_*.json
data/engastado.db
data/*.db
data/engastado.db.backup_*

# Datos reales de producción: nunca al repo (es público)
# - Excel de cortes subidos por el usuario
# - Etiquetas ZPL generadas en modo simulación
data/cortes/
data/etiquetas_simuladas/
# Firmwares .bin e instaladores de drivers subidos desde Admin -> ESP32.
# Son binarios grandes y propios de cada instalación, no del repo.
data/firmware/
data/drivers/

# Configuración local de VS Code
*.code-workspace

# Basura del sistema operativo
.DS_Store
Thumbs.db
desktop.ini
passwords.txt

# Variables de entorno y credenciales locales
.env
.env.local
.deploy_token
# Clave secreta única por instalación (se genera sola, nunca al repo)
.secret_key
# Credenciales del hotspot WiFi (se configuran desde Admin, nunca al repo)
data/wifi_hotspot.json
# Host local de las placas (se detecta o configura desde Admin en cada instalación)
data/servidor_backend.json
# Temporales de provisión USB RFID; pueden contener WiFi y host locales.
data/_rfid_*_tmp.py

# Coordinación local de copias e importaciones
data/.maintenance.sqlite*
